{
  "name": "ghostrol",
  "version": "0.1.1",
  "private": true,
  "description": "Play Xbox Cloud Gaming with a keyboard and mouse. Free and open source.",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "package": "node scripts/build.mjs --zip",
    "catalog": "node scripts/fetch-catalog.mjs",
    "icons": "node scripts/make-icons.mjs && node scripts/draw-icon.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "lint": "node node_modules/oxlint/bin/oxlint --deny-warnings src tests scripts",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "e2e": "node scripts/build.mjs && node tests/e2e/run.mjs",
    "shots": "node scripts/build.mjs && node tests/e2e/run.mjs --shots",
    "format": "node node_modules/prettier/bin/prettier.cjs --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"tests/**/*.ts\"",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"tests/**/*.ts\"",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "lenis": "1.3.27",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/pirata-one": "^5.3.0",
    "@fontsource/unifrakturmaguntia": "^5.3.0",
    "@types/chrome": "^0.3.7",
    "esbuild": "^0.28.2",
    "oxlint": "1.90.0",
    "playwright": "^1.64.1",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
